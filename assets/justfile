# Global justfile for development commands

# Initialize a development environment from FlakeHub templates
dev-init template:
    nix flake init --template "https://flakehub.com/f/the-nix-way/dev-templates/*#{{template}}"
dev-init-folder template folder_name:
    nix flake new --template "https://flakehub.com/f/the-nix-way/dev-templates/*#{{template}}" {{folder_name}} 

