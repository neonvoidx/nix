{
  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    utils.url = "github:numtide/flake-utils";
  };

  outputs =
    {
      self,
      nixpkgs,
      utils,
    }:
    utils.lib.eachDefaultSystem (
      system:
      let
        pkgs = import nixpkgs { inherit system; };
        bInputs = with pkgs; [
          zig
          (zls.overrideAttrs (old: {
            patchPhase = ""; # Skip broken patchPhase
          }))
          lldb
          libglvnd
          libGL
          mesa
          glfw
          glm
          libGLU
          libgbm
          libx11
          libxrandr
          libxinerama
          libxcursor
          libxi
          wayland
          wayland-protocols
          libxkbcommon
          pkg-config
        ];
      in
      {
        devShell =
          with pkgs;
          mkShell {
            buildInputs = bInputs;
            shellHook = ''
              export LD_LIBRARY_PATH="/run/opengl-driver/lib/:${pkgs.lib.makeLibraryPath bInputs}";
              export PKG_CONFIG_PATH="${pkgs.lib.makeSearchPathOutput "dev" "lib/pkgconfig" bInputs}";
            '';
          };
      }
    );
}
