{ den, inputs, ... }:
{
  den.aspects.luciole = {
    nixos =
      { pkgs, ... }:
      {
        services.gvfs.enable = true;
        xdg.portal = {
          extraPortals = [ inputs.luciole.packages.${pkgs.stdenv.hostPlatform.system}.default ];
          config = {
            common."org.freedesktop.impl.portal.FileChooser" = [
              "luciole"
              "gtk"
            ];
            umbriel."org.freedesktop.impl.portal.FileChooser" = [
              "luciole"
              "gtk"
            ];
          };
        };
      };

    homeManager =
      { pkgs, ... }:
      let
        tomlFormat = pkgs.formats.toml { };
      in
      {
        imports = [ inputs.luciole.homeModules.default ];
        programs.luciole = {
          enable = true;
          settings.browser = {
            background_opacity = 0.9;
            grid_icon_size = 256;
            show_hidden = true;
            show_size_caption = true;
            typing_mode = "typeahead";
            view_mode = "grid";
          };
        };
        # Luciole palette generated by Noctalia.
        home.file.".config/luciole/colors.toml".source = tomlFormat.generate "colors.toml" {
          colors = {
            primary = "#37f499";
            on_primary = "#171928";
            primary_container = "#276154";
            on_primary_container = "#37f499";
            secondary = "#04d1f9";
            on_secondary = "#171928";
            secondary_container = "#185771";
            on_secondary_container = "#15d5fd";
            tertiary = "#a48cf2";
            on_tertiary = "#171928";
            tertiary_container = "#48426f";
            on_tertiary_container = "#bcaaff";
            error = "#f16c75";
            on_error = "#171928";
            error_container = "#5f3849";
            on_error_container = "#ff9094";
            surface = "#212337";
            on_surface = "#ebfafa";
            on_surface_variant = "#abb4da";
            surface_container_low = "#25283c";
            surface_container = "#292e42";
            surface_container_high = "#31374f";
            surface_container_highest = "#39405b";
            outline_variant = "#3b4261";
            shadow = "#414868";
            scrim = "#000000";
            hover = "#a48cf2";
            on_hover = "#171928";
          };
        };
      };
  };
}
